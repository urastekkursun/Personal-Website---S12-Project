# Bu dosyayı `.env` olarak kopyala ve değerleri kendi ortamına göre doldur:
#   cp .env.example .env
#
# UYARI: Vite'ta `VITE_` ile başlayan her değişken build çıktısına GÖMÜLÜR ve
# tarayıcıdan okunabilir. Buraya asla gerçek bir gizli anahtar (secret key,
# private token, DB şifresi) koyma. Sadece public/anonim anahtarlar konabilir.

# Dil değişimini bildiren demo API'nin taban adresi
VITE_API_BASE_URL=https://reqres.in/api

# Dil değişimi POST isteğinin gittiği uç nokta (baseURL'e göre göreli)
VITE_API_LANGUAGE_ENDPOINT=/workintech

# Dil değişimi bildirimi için API anahtarı.
#
# BOŞ BIRAKILIRSA istek hiç atılmaz ve dil değişimi doğrudan başarılı sayılır.
# Varsayılan olarak boş çünkü reqres.in'in eski ücretsiz anahtarı
# (`reqres-free-v1`) servis tarafında iptal edildi — artık her istek
# `401 missing_api_key` dönüyor ve kullanıcıya sebepsiz hata uyarısı çıkıyordu.
#
# İsteği tekrar etkinleştirmek istersen app.reqres.in/api-keys adresinden
# kendi anahtarını al ve buraya yaz.
VITE_API_KEY=

# Axios istek zaman aşımı (milisaniye)
VITE_API_TIMEOUT_MS=8000

# Kişisel blog adresi. BOŞ bırakılırsa footer'daki blog linki hiç gösterilmez
# (eskiden `href="#"` olan ölü bir link vardı).
VITE_BLOG_URL=
